{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "@cloudflare/workers-types/experimental"
    ],
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/game/authority.ts",
    "../src/game/config.ts",
    "../src/game/random.ts",
    "../src/types/index.ts"
  ]
}
